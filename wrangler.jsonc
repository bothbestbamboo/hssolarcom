{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hssolarcom",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  }
}