---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/markdown.css';
import '../styles/b2b-typography.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  isHome?: boolean;
}

const {
  title = SITE.name,
  description = SITE.defaultDescription,
  keywords = SITE.defaultKeywords,
  isHome = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content={keywords}>
    <link rel="shortcut icon" href="/favicon.ico" type="image/png">
    <link type="text/css" rel="stylesheet" href="/Public/layui/css/layui.css">
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/moban.css">
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/bootstrap.css">
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/font-awesome.min.css">
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/swiper.css">
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
    <link type="text/css" rel="stylesheet" href="/Public/theme/default/css/magnific-popup.css">
    <slot name="head" />
    <script is:inline type="text/javascript" src="/Public/Script/jquery.min.js"></script>
    <script is:inline>
        if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
            $(function () {
                $('.phone img').attr("style", "");
                $(".phone img").attr("width", "");
                $(".phone img").attr("height", "");
            });
        }
    </script>
</head>
<body>
    <Header />
    <slot />
    <Footer isHome={isHome} />
    <script is:inline>
      (function () {
        function syncHeaderHeight() {
          var header = document.querySelector('header.site-header-en, header.site-header-cn, header');
          var spacer = document.querySelector('.height');
          if (!header || !spacer) return;
          // 仅在导航栏未滚动收缩时同步高度，避免页面滚动时跳动
          if (header.classList.contains('small')) return;
          var h = Math.floor(header.getBoundingClientRect().height);
          if (h > 40) {
            spacer.style.setProperty('height', h + 'px', 'important');
          }
        }

        syncHeaderHeight();
        window.addEventListener('load', syncHeaderHeight);
        window.addEventListener('resize', syncHeaderHeight);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(syncHeaderHeight);
        }
        var hdr = document.querySelector('header');
        if (hdr) {
          hdr.addEventListener('transitionend', function () {
            if (!hdr.classList.contains('small')) syncHeaderHeight();
          });
        }
      })();
    </script>
</body>
</html>