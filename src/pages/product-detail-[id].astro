---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import { CATEGORIES } from '../data/categories';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: String(product.data.id) },
    props: { product, allProducts: products },
  }));
}

const { product, allProducts } = Astro.props;
const { Content } = await render(product);
const gallery = product.data.gallery?.length ? product.data.gallery : [product.data.image];

const primaryCatId = product.data.categoryIds?.[0];
const primaryCat = CATEGORIES.find((c) => c.id === primaryCatId);

const relatedProducts = allProducts
  .filter((p) => p.data.id !== product.data.id)
  .slice(0, 4);
---

<BaseLayout
  title={product.data.seoTitle || `${product.data.title} - Homesun Solar`}
  description={product.data.description || product.data.summary || product.data.title}
  keywords={product.data.keywords || product.data.tags?.join(', ')}
>
  <InnerBanner
    title={primaryCat ? primaryCat.name : 'Product Details'}
    bannerImg="/Uploads/images/20241119/673c9f32ace84.jpg"
    breadcrumbs={[
      { label: 'Products', href: '/category.html' },
      ...(primaryCat ? [{ label: primaryCat.name, href: `/category-${primaryCat.id}.html` }] : []),
      { label: product.data.title },
    ]}
  />

  <div class="container" style="padding: 40px 15px 60px;">
    <!-- 上半部分：相册 + 核心参数与询盘按钮 -->
    <div class="row" style="margin-bottom: 40px;">
      <div class="col-md-5 col-sm-12">
        <div class="swiper" id="pro_img_gallery" style="border: 1px solid #eee; margin-bottom: 10px;">
          <div class="swiper-wrapper">
            {gallery.map((img: string) => (
              <div class="swiper-slide">
                <img src={img} alt={product.data.title} style="width:100%; height:360px; object-fit:contain;" />
              </div>
            ))}
          </div>
        </div>
        {gallery.length > 1 && (
          <div class="swiper" id="pro_img_thumbs">
            <div class="swiper-wrapper">
              {gallery.map((img: string) => (
                <div class="swiper-slide" style="cursor:pointer; border:1px solid #eee;">
                  <img src={img} alt={product.data.title} style="width:100%; height:64px; object-fit:contain;" />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="col-md-7 col-sm-12">
        <h2 style="margin-top: 0; font-weight: 700;">{product.data.title}</h2>
        {product.data.summary && (
          <p style="font-size: 15px; line-height: 1.7; color: #555; margin: 18px 0;">
            {product.data.summary}
          </p>
        )}

        {product.data.specs && product.data.specs.length > 0 && (
          <table class="table table-bordered table-striped" style="margin-top: 20px;">
            <tbody>
              {product.data.specs.map((spec: { label: string; value: string }) => (
                <tr>
                  <th style="width: 35%;">{spec.label}</th>
                  <td>{spec.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}

        <div style="margin-top: 25px; display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="/contact-us.html" class="btn btn-primary btn-lg">Get A Quote</a>
          {product.data.datasheet && (
            <a href={product.data.datasheet} target="_blank" class="btn btn-default btn-lg">
              Download Datasheet (PDF)
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- 下半部分：Markdown 正文详情（支持参数表格、证书图等） -->
    <div class="panel panel-default">
      <div class="panel-heading"><strong>Product Description & Technical Data</strong></div>
      <div class="panel-body phone" style="padding: 25px; line-height: 1.8;">
        <Content />
      </div>
    </div>

    <!-- 相关产品 -->
    {relatedProducts.length > 0 && (
      <div style="margin-top: 50px;">
        <h3 style="margin-bottom: 20px;">Related Products</h3>
        <div class="row">
          {relatedProducts.map((item) => (
            <div class="col-md-3 col-sm-6" style="margin-bottom: 20px;">
              <div class="thumbnail">
                <a href={`/product-detail-${item.data.id}.html`}>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    style="width:100%; height:180px; object-fit:contain; padding:8px;"
                  />
                </a>
                <div class="caption">
                  <a href={`/product-detail-${item.data.id}.html`} style="font-size: 14px;">
                    {item.data.title}
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>