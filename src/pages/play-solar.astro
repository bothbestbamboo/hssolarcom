---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const defaultIntroMap: Record<number, { title: string; image: string; summary: string }> = {
  8: {
    title: 'Why Photovoltaics',
    image: '/Uploads/images/20241116/67386ab8880da.jpg',
    summary:
      "A solar power system from Homesun solar on your roof, the sun's rays into electricity, which you can use for self-consumption. A solar power system in combination with an electricity storage unit from Homesun solar is particularly clever! It ensures that you can use your solar power even when the sun is not shining - exactly when you need it. As a result you have to buy less electricity from an energy supplier - and can save up to 80% on your electricity costs!",
  },
  9: {
    title: 'Benefits of PV System',
    image: '/Uploads/images/20241116/67386b51b8d3e.jpg',
    summary:
      'Having an Homesun solar power system on your roof lets you turn solar radiation into energy you can use – in many ways. On-grid, off-grid or hybrid solutions: Perfectly customized to your requirements. Direct self-consumption of solar power: Gaining independence from energy suppliers and reducing your electricity bills. Storage to increase self-consumption share: Ensuring that you can use solar power even when the sun is not shining.',
  },
  13: {
    title: 'Solar Basics',
    image: '/Uploads/images/20241123/67417df4c6112.jpg',
    summary:
      'In order to have a deeper understanding of photovoltaic products and technologies, we need to start with the basic knowledge of electricity and solar panels. Here you can obtain comprehensive and professional photovoltaic basic knowledge.',
  },
  14: {
    title: 'Future Clean Energy',
    image: '/Uploads/images/20241125/67446bdacd824.jpg',
    summary:
      'As the world moves towards clean, sustainable energy, solar energy is set to play a significant role. Solar panels are leading the renewable energy revolution due to technological improvements, falling costs, and increased environmental consciousness.',
  },
};

const knowledgeEntries = (await getCollection('news'))
  .filter((n) => n.data.type === 'knowledge')
  .sort((a, b) => a.data.id - b.data.id);

const sections =
  knowledgeEntries.length > 0
    ? knowledgeEntries.map((item) => {
        const fallback = defaultIntroMap[item.data.id];
        return {
          id: item.data.id,
          title: item.data.title || fallback?.title || '',
          image: item.data.image || fallback?.image || '',
          summary: fallback?.summary || item.data.summary || '',
        };
      })
    : Object.entries(defaultIntroMap).map(([id, val]) => ({
        id: Number(id),
        ...val,
      }));

const PLAY_BANNER = '/Public/theme/default/image/play-solar.jpg';
---

<BaseLayout
  title="Play Solar - Homesun: China Solar Panels Supplier"
  description="Solar is a clean and free energy. Homesun manufactures solar panels, modules, inverters and offers full solar solutions, factory based in China with worldwide shipping."
  keywords="solar panels, china, supplier"
  preloadImage={PLAY_BANNER}
>
  <div class="height"></div>
  <div class="inner_banner">
    <a>
      <picture>
        <img
          src={PLAY_BANNER}
          alt="play-solar"
          width="1920"
          height="650"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </a>
    <div class="ovrly"></div>
    <div class="bgs"></div>
  </div>

  <div class="mbx_section">
    <div class="container">
      <div class="maintitle">Solar energy knowledge</div>
      <div class="mbx">
        <a href="/"><i class="fa fa-home"></i>Home</a>
        <span>/</span>
        <h2>Solar energy knowledge</h2>
      </div>
    </div>
  </div>

  <div class="n_main">
    <div class="page-nav-box js-page-nav-box">
      <div class="page-nav js-page-nav">
        <ul class="list">
          {sections.map((sec, idx) => (
            <li class={`pnav-item${idx === 0 ? ' current' : ''}`} data-target={`#overview_${sec.id}`}>
              <a href={`#overview_${sec.id}`} data-href={`#overview_${sec.id}`} class="pnav-link"></a>
              <p>{sec.title}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {sections.map((sec) => (
      <div class="nav-page" id={`overview_${sec.id}`}>
        <div class="solar_text clearfix">
          <div class="container clearfix">
            <div class="img_left">
              <picture>
                <img src={sec.image} alt={sec.title} loading="lazy" decoding="async" />
              </picture>
            </div>
            <div class="wrap">
              <div class="maintitle">{sec.title}</div>
              <p>{sec.summary}</p>
              <div class="more_btn">
                <a href={`/news-${sec.id}.html`}>Read more</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <style is:global>
    .js-page-nav .pnav-item {
      cursor: pointer;
    }
  </style>

  <script is:inline>
    (function () {
      var items = document.querySelectorAll('.js-page-nav .pnav-item');
      var navBox = document.querySelector('.js-page-nav-box');
      var navBar = document.querySelector('.js-page-nav');
      var pages = document.querySelectorAll('.nav-page');
      if (!items.length) return;

      function getOffset() {
        var header = document.querySelector('header');
        var headerH = header ? header.getBoundingClientRect().height : 80;
        var navH = navBar ? navBar.getBoundingClientRect().height : 60;
        return headerH + navH + 16;
      }

      items.forEach(function (item) {
        item.addEventListener('click', function (e) {
          var link = item.querySelector('.pnav-link');
          var selector = item.getAttribute('data-target') || (link && (link.getAttribute('data-href') || link.getAttribute('href')));
          if (!selector || selector.charAt(0) !== '#') return;
          var target = document.querySelector(selector);
          if (!target) return;

          e.preventDefault();
          var y = target.getBoundingClientRect().top + window.pageYOffset - getOffset();
          window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });

          items.forEach(function (el) { el.classList.remove('current'); });
          item.classList.add('current');
        });
      });

      if (navBox && navBar) {
        window.addEventListener('scroll', function () {
          var header = document.querySelector('header');
          var headerH = header ? header.getBoundingClientRect().height : 80;
          var boxTop = navBox.getBoundingClientRect().top + window.pageYOffset;
          navBar.classList.toggle('fixed', window.pageYOffset > boxTop - headerH);

          var scrollCheck = window.pageYOffset + getOffset() + 20;
          pages.forEach(function (sec) {
            var top = sec.offsetTop;
            var bottom = top + sec.offsetHeight;
            if (scrollCheck >= top && scrollCheck < bottom) {
              var id = '#' + sec.id;
              items.forEach(function (el) {
                el.classList.toggle('current', el.getAttribute('data-target') === id);
              });
            }
          });
        }, { passive: true });
      }
    })();
  </script>
</BaseLayout>