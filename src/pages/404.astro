---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PRODUCT_CATEGORIES, POPULAR_TAGS } from '../data/site';

const quickLinks = [
  { label: 'Back to Home', href: '/', primary: true },
  { label: 'All Products', href: '/category.html' },
  { label: 'Projects', href: '/project.html' },
  { label: 'Play Solar', href: '/play-solar.html' },
  { label: 'FAQ', href: '/faq.html' },
  { label: 'Get a Quote', href: '/contact-us.html' },
];
---

<BaseLayout
  title={`404 Page Not Found | ${SITE.name}`}
  description="The page you requested could not be found. Search Homesun solar panels, inverters, BESS, or browse our main product categories."
  keywords="404, page not found, Homesun solar"
>
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <!-- 占位块：防止顶部 fixed 导航栏遮挡页面内容 -->
  <div class="height"></div>

  <section class="hs-404-section">
    <div class="container">
      <div class="hs-404-card">
        <div class="hs-404-badge">Error 404</div>
        <div class="hs-404-code" aria-hidden="true">404</div>
        <h1 class="hs-404-title">Page Not Found</h1>
        <p class="hs-404-desc">
          Sorry, the page you are looking for may have been moved, renamed, or is no longer available.
          Use the search bar below to find solar products, or explore our main sections directly.
        </p>

        <!-- 站内搜索（与顶栏搜索保持一致，提交到 /category.html?labels=） -->
        <form action="/category.html" method="get" class="hs-404-search" role="search">
          <div class="hs-404-search-box">
            <i class="fa fa-search hs-404-search-icon" aria-hidden="true"></i>
            <input
              type="text"
              name="labels"
              class="hs-404-search-input"
              placeholder="Search solar modules, inverters, BESS..."
              aria-label="Search solar products"
              required
            />
            <button type="submit" class="hs-404-search-btn">Search</button>
          </div>
        </form>

        <!-- 热门搜索标签（自动读取 site.ts） -->
        {POPULAR_TAGS.length > 0 && (
          <div class="hs-404-tags" aria-label="Popular searches">
            <span class="hs-404-tags-label">Popular Searches:</span>
            {POPULAR_TAGS.map((tag) => (
              <a href={`/category-tags-${tag.id}.html`} class="hs-404-tag">
                {tag.name}
              </a>
            ))}
          </div>
        )}

        <!-- 快捷导航按钮 -->
        <div class="hs-404-actions" aria-label="Quick navigation">
          {quickLinks.map((item) => (
            <a
              href={item.href}
              class={`hs-404-btn${item.primary ? ' is-primary' : ''}`}
            >
              {item.label}
            </a>
          ))}
        </div>

        <!-- 6 大产品分类卡片（自动读取 site.ts） -->
        <div class="hs-404-categories">
          <h2 class="hs-404-cat-title">Browse Solar Product Categories</h2>
          <div class="hs-404-cat-grid">
            {PRODUCT_CATEGORIES.map((cat) => (
              <a href={`/category-${cat.id}.html`} class="hs-404-cat-card">
                <div class="hs-404-cat-head">
                  <strong>{cat.name}</strong>
                  <i class="fa fa-angle-right" aria-hidden="true"></i>
                </div>
                {cat.children && cat.children.length > 0 && (
                  <p class="hs-404-cat-sub">
                    {cat.children.slice(0, 3).map((sub) => sub.name).join(' · ')}
                  </p>
                )}
              </a>
            ))}
          </div>
        </div>

        <!-- B2B 快捷联系条 -->
        <div class="hs-404-support">
          <span>Looking for a specific datasheet or quotation?</span>
          <div class="hs-404-support-links">
            <a rel="nofollow" href={`mailto:${SITE.email}`}>
              <i class="fa fa-envelope-o" aria-hidden="true"></i> {SITE.email}
            </a>
            <a rel="nofollow" href={`Tel:${SITE.phone}`}>
              <i class="fa fa-phone" aria-hidden="true"></i> {SITE.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-404-section {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    padding: 48px 0 64px;
    border-top: 1px solid #e2e8f0;
  }

  .hs-404-card {
    max-width: 960px;
    margin: 0 auto;
    padding: 44px 40px 36px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: 4px solid #2596d1;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
    text-align: center;
    box-sizing: border-box;
  }

  .hs-404-badge {
    display: inline-block;
    padding: 4px 12px;
    margin-bottom: 10px;
    border-radius: 999px;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hs-404-code {
    font-size: 84px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #2596d1;
    margin-bottom: 10px;
  }

  .hs-404-title {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    color: #111827;
  }

  .hs-404-desc {
    max-width: 620px;
    margin: 0 auto 28px;
    font-size: 15px;
    line-height: 1.7;
    color: #4b5563;
  }

  /* 站内搜索栏 */
  .hs-404-search {
    max-width: 580px;
    margin: 0 auto 14px;
  }

  .hs-404-search-box {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 4px 4px 4px 18px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-404-search-box:focus-within {
    border-color: #2596d1;
    box-shadow: 0 0 0 3px rgba(37, 150, 209, 0.16);
  }

  .hs-404-search-icon {
    color: #94a3b8;
    font-size: 15px;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .hs-404-search-input {
    flex: 1 1 auto;
    min-width: 0;
    height: 40px;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14.5px;
    color: #111827;
  }

  .hs-404-search-input::placeholder {
    color: #94a3b8;
  }

  .hs-404-search-btn {
    height: 40px;
    padding: 0 24px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%);
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .hs-404-search-btn:hover {
    filter: brightness(1.06);
  }

  /* 热门搜索标签 */
  .hs-404-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
    font-size: 13px;
  }

  .hs-404-tags-label {
    color: #6b7280;
    font-weight: 500;
  }

  .hs-404-tag {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .hs-404-tag:hover {
    background: #e0f2fe;
    color: #2596d1;
    text-decoration: none;
  }

  /* 快捷导航按钮 */
  .hs-404-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 34px;
  }

  .hs-404-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 18px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    background: #ffffff;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hs-404-btn:hover {
    border-color: #2596d1;
    background: #f0f9ff;
    color: #2596d1;
    text-decoration: none;
  }

  .hs-404-btn.is-primary {
    border-color: #2596d1;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%);
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(37, 150, 209, 0.24);
  }

  .hs-404-btn.is-primary:hover {
    filter: brightness(1.05);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* 产品分类网格 */
  .hs-404-categories {
    padding-top: 28px;
    border-top: 1px solid #e5e7eb;
    text-align: left;
  }

  .hs-404-cat-title {
    margin: 0 0 18px;
    font-size: 17px;
    font-weight: 700;
    color: #111827;
    text-align: center;
  }

  .hs-404-cat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .hs-404-cat-card {
    display: block;
    padding: 16px 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .hs-404-cat-card:hover {
    border-color: #2596d1;
    background: #f0f9ff;
    transform: translateY(-2px);
    text-decoration: none;
  }

  .hs-404-cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .hs-404-cat-head strong {
    font-size: 15px;
    font-weight: 600;
    color: #111827;
  }

  .hs-404-cat-card:hover .hs-404-cat-head strong,
  .hs-404-cat-head .fa {
    color: #2596d1;
  }

  .hs-404-cat-sub {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    color: #64748b;
  }

  /* 底部快捷联系条 */
  .hs-404-support {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px dashed #e2e8f0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 20px;
    font-size: 13.5px;
    color: #64748b;
  }

  .hs-404-support-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .hs-404-support-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #2596d1;
    font-weight: 600;
    text-decoration: none;
  }

  .hs-404-support-links a:hover {
    color: #1a7bb9;
    text-decoration: underline;
  }

  @media (max-width: 991px) {
    .hs-404-cat-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .hs-404-section {
      padding: 28px 0 44px;
    }

    .hs-404-card {
      padding: 28px 18px 24px;
    }

    .hs-404-code {
      font-size: 64px;
    }

    .hs-404-title {
      font-size: 22px;
    }

    .hs-404-search-box {
      padding-left: 14px;
    }

    .hs-404-search-btn {
      padding: 0 16px;
    }

    .hs-404-cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>