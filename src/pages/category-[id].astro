---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import ProductSidebar from '../components/ProductSidebar.astro';
import { CATEGORIES } from '../data/categories';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');

  return CATEGORIES.map((cat) => {
    const childIds = CATEGORIES.filter((c) => c.parentId === cat.id).map((c) => c.id);
    const matchIds = [cat.id, ...childIds];

    const filteredProducts =
      cat.id === 31
        ? [...allProducts].sort((a, b) => a.data.id - b.data.id)
        : allProducts
            .filter((p) => p.data.categoryIds.some((cid: number) => matchIds.includes(cid)))
            .sort((a, b) => a.data.id - b.data.id);

    const parentCat = cat.parentId
      ? CATEGORIES.find((c) => c.id === cat.parentId)
      : undefined;

    return {
      params: { id: String(cat.id) },
      props: { cat, parentCat, products: filteredProducts },
    };
  });
}

const { cat, parentCat, products } = Astro.props;

const breadcrumbs =
  cat.id === 31
    ? [{ label: 'All Products' }]
    : [
        { label: 'Products', href: '/category.html' },
        ...(parentCat ? [{ label: parentCat.name, href: `/category-${parentCat.id}.html` }] : []),
        { label: cat.name },
      ];
---

<BaseLayout
  title={cat.seoTitle || `${cat.name} - Homesun Solar`}
  description={cat.description || `${cat.name} supplied directly from Homesun Solar China factory.`}
>
  <InnerBanner
    title={cat.name}
    bannerImg={cat.bannerImg || '/Uploads/images/20241119/673c9f32ace84.jpg'}
    breadcrumbs={breadcrumbs}
  />

  <div class="container" style="padding: 40px 15px 60px;">
    <div class="row">
      <!-- 左侧公共分类栏（id=31 时高亮 All Products） -->
      <div class="col-md-3 col-sm-12" style="margin-bottom: 30px;">
        <ProductSidebar activeCategoryId={cat.id === 31 ? undefined : cat.id} />
      </div>

      <main class="col-md-9 col-sm-12">
        {cat.description && (
          <div class="well" style="margin-bottom: 25px;">
            <p style="margin:0;">{cat.description}</p>
          </div>
        )}

        {products.length > 0 ? (
          <div class="row">
            {products.map((item) => (
              <div class="col-md-4 col-sm-6" style="margin-bottom: 30px;">
                <div class="thumbnail" style="height: 100%;">
                  <a href={`/product-detail-${item.data.id}.html`}>
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      style="width:100%; height:220px; object-fit:contain; padding:10px;"
                    />
                  </a>
                  <div class="caption">
                    <h4 style="font-size: 16px; line-height: 1.4; min-height: 44px;">
                      <a href={`/product-detail-${item.data.id}.html`}>{item.data.title}</a>
                    </h4>
                    <a href={`/product-detail-${item.data.id}.html`} class="btn btn-primary btn-sm">
                      View Details
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="alert alert-warning">
            No products listed in <strong>{cat.name}</strong> yet. Please <a href="/contact-us.html">contact us</a> for specifications and quotation.
          </div>
        )}
      </main>
    </div>
  </div>
</BaseLayout>