---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import ProductSidebar from '../components/ProductSidebar.astro';
import { CATEGORIES } from '../data/categories';

export async function getStaticPaths() {
  const allProducts = await getCollection('products');

  return CATEGORIES.map((cat) => {
    const subCategories = CATEGORIES.filter((c) => c.parentId === cat.id && !c.hidden);
    const childIds = subCategories.map((c) => c.id);
    const matchIds = [cat.id, ...childIds];

    const filteredProducts =
      cat.id === 31
        ? [...allProducts].sort((a, b) => a.data.id - b.data.id)
        : allProducts
            .filter((p) => p.data.categoryIds.some((cid: number) => matchIds.includes(cid)))
            .sort((a, b) => a.data.id - b.data.id);

    const parentCat = cat.parentId
      ? CATEGORIES.find((c) => c.id === cat.parentId)
      : undefined;

    return {
      params: { id: String(cat.id) },
      props: { cat, parentCat, subCategories, products: filteredProducts },
    };
  });
}

const { cat, parentCat, subCategories, products } = Astro.props;

const breadcrumbs =
  cat.id === 31
    ? [{ label: 'All Products' }]
    : [
        { label: 'Products', href: '/category.html' },
        ...(parentCat ? [{ label: parentCat.name, href: `/category-${parentCat.id}.html` }] : []),
        { label: cat.name },
      ];
---

<BaseLayout
  title={cat.seoTitle || `${cat.name} - Homesun Solar`}
  description={cat.description || `${cat.name} supplied directly from Homesun Solar China factory.`}
>
  <InnerBanner
    title={cat.name}
    subtitle={cat.description}
    bannerImg={cat.bannerImg || '/Public/theme/default/picture/product.jpg'}
    breadcrumbs={breadcrumbs}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container hs-two-col">
      <!-- 左侧产品分类 -->
      <ProductSidebar activeCategoryId={cat.id === 31 ? undefined : cat.id} />

      <!-- 右侧产品网格 -->
      <div class="hs-main-col">
        {subCategories.length > 0 && (
          <div class="hs-subcat-bar" aria-label="Subcategories">
            <span class="hs-subcat-label">Subcategories:</span>
            {subCategories.map((sub) => (
              <a href={`/category-${sub.id}.html`} class="hs-subcat-pill">
                {sub.name}
              </a>
            ))}
          </div>
        )}

        {products.length > 0 ? (
          <div class="hs-pro-grid">
            {products.map((item) => (
              <article class="hs-pro-card">
                <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-media">
                  {item.data.tags && item.data.tags.length > 0 && (
                    <span class="hs-pro-badge">{item.data.tags[0]}</span>
                  )}
                  <picture>
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
                <div class="hs-pro-body">
                  <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-title">
                    {item.data.title}
                  </a>
                  <a href={`/product-detail-${item.data.id}.html`} class="hs-pro-cta">
                    View Specs &amp; Quote <span>→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="hs-empty-box">
            No products listed in this category yet.{' '}
            <a href="/contact-us.html" style="color: #2596d1; font-weight: 600;">Contact us</a>{' '}
            for the latest factory catalog.
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-subcat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px 18px;
    margin-bottom: 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }
  .hs-subcat-label {
    font-size: 13px;
    font-weight: 700;
    color: #0f172a;
    margin-right: 4px;
  }
  .hs-subcat-pill {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    transition: all 0.18s ease;
  }
  .hs-subcat-pill:hover {
    background: #2596d1;
    border-color: #2596d1;
    color: #ffffff;
  }
</style>