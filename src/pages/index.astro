---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_BANNERS, PRODUCT_CATEGORIES } from '../data/site';
import { getTopCategories } from '../data/categories';

const allProducts = await getCollection('products');
const hotProducts = allProducts
  .filter((p) => p.data.isHot)
  .sort((a, b) => a.data.id - b.data.id);

const allNews = await getCollection('news');
const caseStudies = allNews
  .filter((n) => n.data.type === 'case')
  .sort((a, b) => a.data.id - b.data.id);

const solutions = allNews
  .filter((n) => n.data.type === 'solution')
  .sort((a, b) => a.data.id - b.data.id)
  .slice(0, 2);

const knowledgeList = allNews
  .filter((n) => n.data.type === 'knowledge')
  .sort((a, b) => a.data.id - b.data.id)
  .slice(0, 4);

const latestNews = allNews
  .filter((n) => n.data.type === 'news')
  .sort((a, b) => {
    const timeDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    return timeDiff !== 0 ? timeDiff : b.data.id - a.data.id;
  })
  .slice(0, 3);

const topCategories = getTopCategories().map((cat) => {
  const match = PRODUCT_CATEGORIES.find((p) => p.id === cat.id);
  const subPreview = match?.children.slice(0, 3).map((c) => c.name).join(' · ') || '';
  return { ...cat, subPreview };
});

const factoryStats = [
  { value: '10+', label: 'Years Manufacturing', sub: 'Automated PV Production' },
  { value: '750Wp', label: 'Max Module Output', sub: 'N-Type TOPCon & HJT' },
  { value: '110+', label: 'Countries Reached', sub: 'Global Logistics Network' },
  { value: '2,000+', label: 'Global B2B Partners', sub: 'TÜV & Intertek Certified' },
];

const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  return dateStr.slice(0, 10);
};
---

<BaseLayout
  title="Homesun: China Solar Panels Supplier"
  description="Homesun manufactures solar panels, modules, inverters and offers full solar solutions, factory based in China with worldwide shipping."
  keywords="solar panels, china, supplier"
  isHome={true}
  preloadImage={HOME_BANNERS[0].img}
>
  <div class="height"></div>

  <main class="hs-home">
    <!-- 1. 首屏 Hero 轮播（支持后期自由更换无文字底图） -->
    <section class="hs-hero-wrap" aria-label="Featured Highlights">
      <div class="swiper-banner index_banner hs-hero">
        <div class="swiper-wrapper">
          {HOME_BANNERS.map((banner, idx) => (
            <div class="swiper-slide">
              <div class="slide-inner">
                <picture>
                  <img
                    class="hs-hero-bg"
                    src={banner.img}
                    alt={banner.alt}
                    width="1920"
                    height="720"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : 'low'}
                    decoding="async"
                  />
                </picture>
                <div class="hs-hero-overlay" aria-hidden="true"></div>
                <div class="hs-hero-content">
                  <div class="hs-container">
                    <div class="hs-hero-box">
                      <span class="hs-hero-badge">{banner.badge}</span>
                      {idx === 0 ? (
                        <h1 class="hs-hero-title">
                          {banner.title}
                          <span>{banner.highlight}</span>
                        </h1>
                      ) : (
                        <h2 class="hs-hero-title">
                          {banner.title}
                          <span>{banner.highlight}</span>
                        </h2>
                      )}
                      <p class="hs-hero-desc">{banner.subtitle}</p>
                      <div class="hs-hero-actions">
                        <a href={banner.primaryLink} class="hs-btn hs-btn-primary">
                          {banner.primaryText}
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                        <a href={banner.secondaryLink} class="hs-btn hs-btn-glass">
                          {banner.secondaryText}
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="swiper-button-prev" aria-label="Previous Slide"></div>
        <div class="swiper-button-next" aria-label="Next Slide"></div>
        <div class="swiper-pagination"></div>
      </div>
    </section>

    <!-- 2. 工厂实力信任带 -->
    <section class="hs-stats-section" aria-label="Company Highlights">
      <div class="hs-container">
        <div class="hs-stats-grid">
          {factoryStats.map((stat) => (
            <div class="hs-stat-item">
              <div class="hs-stat-value">{stat.value}</div>
              <div class="hs-stat-label">{stat.label}</div>
              <div class="hs-stat-sub">{stat.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. 六大核心产品矩阵 -->
    <section class="hs-section hs-section-muted">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">PRODUCT PORTFOLIO</span>
            <h2 class="hs-title">Complete Solar Supply Chain</h2>
            <p class="hs-subtitle">
              From high-efficiency PV modules and smart inverters to lithium BESS and mounting structures.
            </p>
          </div>
          <a href="/category.html" class="hs-link-more">
            All Categories
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-cat-grid">
          {topCategories.map((cat) => (
            <a href={`/category-${cat.id}.html`} class="hs-cat-card">
              <div class="hs-cat-icon" aria-hidden="true">
                {cat.id === 1 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 11h18"/><path d="M9 4v14"/><path d="M15 4v14"/><path d="M8 21h8"/><path d="M12 18v3"/></svg>
                )}
                {cat.id === 3 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M13 7l-4 5h4l-1 5 4-5h-4l1-5z"/></svg>
                )}
                {cat.id === 4 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2" y="7" width="18" height="11" rx="2"/><path d="M22 11v3"/><path d="M6 11v3"/><path d="M10 11v3"/><path d="M14 11v3"/></svg>
                )}
                {cat.id === 5 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                )}
                {cat.id === 6 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M2 20h20"/><path d="m4 14 16-6"/><path d="M7 13v7"/><path d="M17 9v11"/></svg>
                )}
                {cat.id === 7 && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
                )}
              </div>
              <div class="hs-cat-body">
                <h3>{cat.name}</h3>
                {cat.subPreview && <div class="hs-cat-tags">{cat.subPreview}</div>}
                <p>{cat.description}</p>
              </div>
              <span class="hs-cat-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. HOT PRODUCTS 热门产品轮播（保留 .cat_content / .pro_scrollbar 以兼容 demo.js） -->
    <section class="hs-section cat_content hs-products">
      <div class="hs-container">
        <div class="hs-section-head hs-head-center">
          <span class="hs-eyebrow">FEATURED HARDWARE</span>
          <h2 class="hs-title">Hot Products</h2>
          <p class="hs-subtitle">
            Direct-from-factory PV panels and core system components engineered for maximum yield and long-term durability.
          </p>
        </div>

        <div class="hs-swiper-shell">
          <div class="swiper pro_scrollbar">
            <div class="swiper-wrapper">
              {hotProducts.map((item) => (
                <div class="swiper-slide">
                  <article class="hs-product-card">
                    <a href={`/product-detail-${item.data.id}.html`} class="hs-product-media">
                      {item.data.tags && item.data.tags.length > 0 && (
                        <span class="hs-product-tag">{item.data.tags[0]}</span>
                      )}
                      <picture>
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                    </a>
                    <div class="hs-product-body">
                      <a href={`/product-detail-${item.data.id}.html`} class="hs-product-title">
                        {item.data.title}
                      </a>
                      <a href={`/product-detail-${item.data.id}.html`} class="hs-product-cta">
                        View Specs &amp; Quote <span>→</span>
                      </a>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-button-prev hs-nav-btn" aria-label="Previous Product"></div>
          <div class="swiper-button-next hs-nav-btn" aria-label="Next Product"></div>
          <div class="swiper-pagination hs-dots"></div>
        </div>

        <div class="hs-center-action">
          <a href="/category.html" class="hs-btn hs-btn-primary">
            View All Products
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- 5. Why Choose Homesun 品牌核心优势（2x2 均衡现代卡片） -->
    <section class="hs-section hs-section-muted hs-why">
      <div class="hs-container">
        <div class="hs-section-head hs-head-center">
          <span class="hs-eyebrow">WHY CHOOSE HOMESUN</span>
          <h2 class="hs-title">Engineered for Reliability</h2>
          <p class="hs-subtitle">
            A decade of vertical integration, rigorous third-party testing, and dependable global project support.
          </p>
        </div>

        <div class="hs-why-grid">
          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">01</span>
              <picture>
                <source type="image/webp" srcset="/Public/theme/default/picture/1721045333_3vVNWtUjmd.webp" />
                <img
                  src="/Public/theme/default/picture/1721045333_3vVNWtUjmd.png"
                  alt="High Performance, Competitive Pricing"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>High Output, Factory Pricing</h3>
              <p>
                Homesun N-Type and HJT modules reach over 700Wp peak power to maximize generation per square meter.
                With one-stop supply from system design to component delivery, we keep LCOE highly competitive.
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">02</span>
              <picture>
                <source type="image/webp" srcset="/Public/theme/default/picture/1721095476_ZCdp1MpELP.webp" />
                <img
                  src="/Public/theme/default/picture/1721095476_ZCdp1MpELP.png"
                  alt="Strict Quality Control"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>Strict Quality Control</h3>
              <p>
                Every production stage—from raw cell inspection and EL testing to export packaging—follows strict QC protocols
                verified by independent international authorities including TÜV and Intertek.
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">03</span>
              <picture>
                <source type="image/webp" srcset="/Public/theme/default/picture/1721808780_1USSy0dTM9.webp" />
                <img
                  src="/Public/theme/default/picture/1721808780_1USSy0dTM9.png"
                  alt="Technical & Engineering Support"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>Technical Expertise</h3>
              <p>
                Backed by experienced PV engineers and automated production teams, we provide responsive pre-sale system sizing,
                inverter-to-module matching, and dedicated after-sales technical guidance.
              </p>
            </div>
          </article>

          <article class="hs-why-card">
            <div class="hs-why-media">
              <span class="hs-why-num">04</span>
              <picture>
                <source type="image/webp" srcset="/Public/theme/default/picture/1721095611_eUbkVjMtB9.webp" />
                <img
                  src="/Public/theme/default/picture/1721095611_eUbkVjMtB9.png"
                  alt="Responsible Energy Partner"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="hs-why-body">
              <h3>Mission &amp; Responsibility</h3>
              <ul class="hs-why-list">
                <li><strong>Mission:</strong> Illuminate the future with clean solar power.</li>
                <li><strong>Vision:</strong> Build a reliable global green energy network.</li>
                <li><strong>Values:</strong> Customer-centric service and integrity-driven manufacturing.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. Global Case Studies 工程案例轮播（保留 .case_content / .case_scrollbar 兼容 demo.js） -->
    <section class="hs-section case_content hs-cases">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">GLOBAL FOOTPRINT</span>
            <h2 class="hs-title">Explore Case Studies</h2>
            <p class="hs-subtitle">
              Homesun PV systems and storage installations operating across more than 100 countries and regions.
            </p>
          </div>
          <a href="/project.html" class="hs-link-more">
            All Projects
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-swiper-shell">
          <div class="swiper case_scrollbar">
            <div class="swiper-wrapper">
              {caseStudies.map((item) => (
                <div class="swiper-slide">
                  <article class="hs-case-card">
                    <a href={`/news-${item.data.id}.html`} class="hs-case-media">
                      <picture>
                        <img
                          src={item.data.image}
                          alt={item.data.title}
                          loading="lazy"
                          decoding="async"
                        />
                      </picture>
                      <div class="hs-case-scrim" aria-hidden="true"></div>
                      <div class="hs-case-overlay">
                        <h3>{item.data.title}</h3>
                        <p>{item.data.summary}</p>
                        <span class="hs-case-link">Read Case Study →</span>
                      </div>
                    </a>
                  </article>
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-button-prev hs-nav-btn" aria-label="Previous Case"></div>
          <div class="swiper-button-next hs-nav-btn" aria-label="Next Case"></div>
          <div class="swiper-pagination hs-dots"></div>
        </div>
      </div>
    </section>

    <!-- 7. Solution 系统解决方案 -->
    <section class="hs-section hs-section-dark hs-solutions">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow hs-eyebrow-light">SYSTEM SOLUTIONS</span>
            <h2 class="hs-title hs-title-light">Tailored Solar Power Solutions</h2>
            <p class="hs-subtitle hs-subtitle-light">
              Serving over 2,000 residential, commercial, and industrial clients in 110 countries with end-to-end engineering support.
            </p>
          </div>
          <a href="/category-5.html" class="hs-link-more hs-link-light">
            Explore Solutions
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-solution-grid">
          {solutions.map((item) => (
            <article class="hs-solution-card">
              <a href={`/news-${item.data.id}.html`} class="hs-solution-link">
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div class="hs-solution-scrim" aria-hidden="true"></div>
                <div class="hs-solution-body">
                  <h3>{item.data.title}</h3>
                  <p>{item.data.summary}</p>
                  <span class="hs-solution-btn">
                    Explore Solution
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. Solar Knowledge Hub 光伏知识库 -->
    <section class="hs-section hs-section-muted hs-knowledge">
      <div class="hs-container">
        <div class="hs-knowledge-layout">
          <div class="hs-knowledge-intro">
            <span class="hs-eyebrow">SOLAR KNOWLEDGE HUB</span>
            <h2 class="hs-title">Become a Solar Expert with <span>Homesun</span></h2>
            <p class="hs-subtitle">
              Explore practical engineering guides covering how PV systems work, off-grid design tips,
              storage sizing, and clean energy innovations.
            </p>
            <a href="/play-solar.html" class="hs-btn hs-btn-primary">
              Explore Knowledge Hub
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>

          <div class="hs-knowledge-grid">
            {knowledgeList.map((item) => (
              <article class="hs-know-card">
                <a href={`/news-${item.data.id}.html`} class="hs-know-media">
                  <picture>
                    <img
                      src={item.data.image}
                      alt={item.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </a>
                <div class="hs-know-body">
                  <a href={`/news-${item.data.id}.html`} class="hs-know-title">
                    {item.data.title}
                  </a>
                  <a href={`/news-${item.data.id}.html`} class="hs-know-more">Read Guide →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Latest News 最新资讯 -->
    <section class="hs-section hs-news">
      <div class="hs-container">
        <div class="hs-section-head hs-head-split">
          <div>
            <span class="hs-eyebrow">NEWS &amp; INSIGHTS</span>
            <h2 class="hs-title">Latest News</h2>
            <p class="hs-subtitle">
              Solar industry trends, technical articles, and the latest updates from Homesun factory.
            </p>
          </div>
          <a href="/news.html" class="hs-link-more">
            View All News
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hs-news-grid">
          {latestNews.map((item) => (
            <article class="hs-news-card">
              <a href={`/news-${item.data.id}.html`} class="hs-news-media">
                <picture>
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <div class="hs-news-body">
                <div class="hs-news-date">{formatDate(item.data.date)}</div>
                <a href={`/news-${item.data.id}.html`} class="hs-news-title">
                  {item.data.title}
                </a>
                <p class="hs-news-summary">{item.data.summary}</p>
                <a href={`/news-${item.data.id}.html`} class="hs-news-more">
                  Read Article
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. 底部询盘转化横幅（Pre-Footer CTA） -->
    <section class="hs-cta-section">
      <div class="hs-container">
        <div class="hs-cta-box">
          <div class="hs-cta-text">
            <span class="hs-eyebrow hs-eyebrow-light">FACTORY DIRECT B2B SUPPLY</span>
            <h2>Ready to Power Your Next Solar Project?</h2>
            <p>
              Get direct manufacturer pricing, datasheets, and tailored BOM proposals from our engineering team within 12 hours.
            </p>
          </div>
          <div class="hs-cta-actions">
            <a href="/contact-us.html" class="hs-btn hs-btn-white">
              Request a Factory Quote
            </a>
            <a href="/technical-services.html" class="hs-btn hs-btn-glass">
              Technical Support
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* =========================================================
     Homesun Solar EN - Modern B2B Homepage Upgrade
     全部采用 .hs-home 作用域与 px 单位，彻底免疫旧版 rem 缩放冲突
     ========================================================= */
  main.hs-home {
    --hs-brand: #2596d1;
    --hs-brand-dark: #1a7bb9;
    --hs-navy: #0f172a;
    --hs-slate: #334155;
    --hs-muted: #64748b;
    --hs-border: #e2e8f0;
    --hs-surface: #f8fafc;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--hs-slate);
    background: #ffffff;
    overflow-x: hidden;
  }

  main.hs-home *,
  main.hs-home *::before,
  main.hs-home *::after {
    box-sizing: border-box;
  }

