---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    const slug = page.id.replace(/\.md$/, '');
    return {
      params: { slug },
      props: { page, slug },
    };
  });
}

const { page, slug } = Astro.props;
const { Content } = await render(page);

const isAboutGroup = slug === 'about-us' || slug === 'why-we-different';
const defaultBanner = isAboutGroup
  ? '/Public/theme/default/image/about-us-banner.jpg'
  : '/Public/theme/default/picture/product.jpg';

const breadcrumbs = isAboutGroup
  ? slug === 'about-us'
    ? [{ label: 'About Us' }]
    : [
        { label: 'About Us', href: '/about-us.html' },
        { label: page.data.title },
      ]
  : [{ label: page.data.title }];
---

<BaseLayout
  title={page.data.seoTitle || `${page.data.title} - Homesun Solar`}
  description={page.data.description}
  keywords={page.data.keywords}
>
  <InnerBanner
    title={page.data.title}
    bannerImg={page.data.bannerImg || defaultBanner}
    breadcrumbs={breadcrumbs}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container">
      {isAboutGroup && (
        <nav class="hs-page-tabs" aria-label="About Homesun">
          <a href="/about-us.html" class={`hs-page-tab ${slug === 'about-us' ? 'is-active' : ''}`}>
            Company Introduction
          </a>
          <a
            href="/why-we-different.html"
            class={`hs-page-tab ${slug === 'why-we-different' ? 'is-active' : ''}`}
          >
            Why We Are Different
          </a>
          <a href="/news.html" class="hs-page-tab">
            News &amp; Events
          </a>
        </nav>
      )}

      <div class={`hs-page-shell ${slug === 'privacy-policy' ? 'is-narrow' : ''}`}>
        <div class="hs-surface-card hs-page-content markdown-body phone">
          <Content />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .hs-page-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 32px;
  }

  .hs-page-tab {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .hs-page-tab:hover,
  .hs-page-tab.is-active {
    background: #2596d1;
    border-color: #2596d1;
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(37, 150, 209, 0.24);
  }

  .hs-page-shell.is-narrow {
    max-width: 920px;
    margin: 0 auto;
  }

  /* 关于我们：工厂实力指标条 + 图片网格 */
  .hs-page-content .hs-about-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 26px 0 30px;
  }

  .hs-page-content .hs-about-metric {
    padding: 18px 16px;
    border-radius: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 3px solid #2596d1;
  }

  .hs-page-content .hs-about-metric strong {
    display: block;
    font-size: 26px;
    line-height: 1.2;
    color: #0f172a;
    margin-bottom: 4px;
  }

  .hs-page-content .hs-about-metric span {
    font-size: 13px;
    color: #64748b;
  }

  .hs-page-content .hs-about-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 26px;
  }

  .hs-page-content .hs-about-gallery img {
    margin: 0 !important;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  /* Why We Are Different：现代图文交替行（免疫旧版 747px 写死宽度） */
  .hs-page-content .hs-feature-list {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .hs-page-content .hs-feature-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    align-items: center;
    padding: 20px;
    border-radius: 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
  }

  .hs-page-content .hs-feature-row.is-reverse .hs-feature-media {
    order: 2;
  }

  .hs-page-content .hs-feature-row.is-reverse .hs-feature-text {
    order: 1;
  }

  .hs-page-content .hs-feature-media {
    overflow: hidden;
    border-radius: 12px;
  }

  .hs-page-content .hs-feature-media img {
    margin: 0 !important;
    width: 100% !important;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 12px;
  }

  .hs-page-content .hs-feature-num {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    background: #eff6ff;
    color: #2596d1;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .hs-page-content .hs-feature-text h2 {
    margin: 0 0 12px !important;
    padding: 0 !important;
    border: none !important;
    font-size: 22px !important;
  }

  .hs-page-content .hs-feature-text p {
    margin: 0 !important;
    color: #475569;
  }

  /* Technical Services：现代三列服务卡片 */
  .hs-page-content .hs-service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .hs-page-content .hs-service-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .hs-page-content .hs-service-card img {
    margin: 0 !important;
    width: 100% !important;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 0 !important;
  }

  .hs-page-content .hs-service-body {
    padding: 22px;
    flex: 1 1 auto;
  }

  .hs-page-content .hs-service-body h2 {
    margin: 0 0 14px !important;
    padding: 0 !important;
    border: none !important;
    font-size: 19px !important;
    color: #0f172a !important;
  }

  .hs-page-content .hs-service-body ul {
    margin: 0 !important;
    padding-left: 18px !important;
  }

  .hs-page-content .hs-service-body li {
    font-size: 14px;
    line-height: 1.68 !important;
    color: #475569;
  }

  @media (max-width: 991px) {
    .hs-page-content .hs-about-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hs-page-content .hs-feature-row,
    .hs-page-content .hs-service-grid,
    .hs-page-content .hs-about-gallery {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .hs-page-content .hs-feature-row.is-reverse .hs-feature-media {
      order: 1;
    }
    .hs-page-content .hs-feature-row.is-reverse .hs-feature-text {
      order: 2;
    }
  }
</style>