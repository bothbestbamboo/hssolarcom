---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import { SITE } from '../data/site';

const WEB3FORMS_KEY = '007ddd91-be4f-4381-b504-f9464f95e06d';
---

<BaseLayout
  title="Contact - Homesun: China Solar Panels Supplier"
  description="Buy solar panels directly from China supplier. Homesun manufactures solar panels, module, inventer and offers full solar solution, the factory based in China, worldwide shipping."
  keywords="solar panels, china, supplier"
>
  <InnerBanner
    title="Get in touch"
    bannerImg="/Public/theme/default/image/contact-us.jpg"
    bannerAlt="Contact"
    breadcrumbs={[{ label: 'Get in touch' }]}
  />

  <div class="n_main">
    <!-- 顶部三列联系方式栏 -->
    <div class="contact_info">
      <div class="container">
        <ul class="clearfix">
          <li class="col-sm-4 col-xs-12 clearfix">
            <div class="column">
              <div class="icon">
                <span style="background-position: -407px -213px;"></span>
              </div>
              <div class="wrap">
                <em>Call Us</em>
                <p>
                  Tel : <a rel="nofollow" href={`Tel:${SITE.phone}`}>{SITE.phone}</a>
                </p>
              </div>
            </div>
          </li>
          <li class="col-sm-4 col-xs-12 clearfix">
            <div class="column">
              <div class="icon">
                <span style="background-position: -335px -212px;"></span>
              </div>
              <div class="wrap">
                <em>Email us</em>
                <p>
                  Email :{' '}
                  <a rel="nofollow" target="_blank" href={`mailto:${SITE.email}`}>
                    {SITE.email}
                  </a>
                </p>
              </div>
            </div>
          </li>
          <li class="col-sm-4 col-xs-12 clearfix">
            <div class="column">
              <div class="icon">
                <span style="background-position: -264px -212px;"></span>
              </div>
              <div class="wrap">
                <em>Address</em>
                <p>{SITE.address}</p>
              </div>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- 下方主体：左表单 + 右侧三项服务 -->
    <div class="container">
      <div class="contact">
        <div class="con_main">
          <div class="row">
            <!-- 左侧询盘表单（自动走 Footer.astro 的 Web3Forms 提交流程） -->
            <div class="col-sm-6">
              <div class="send_column">
                <div class="section_title">Message</div>
                <div class="text">
                  If you are interested in our solar products, want to know more details and get
                  our quotation, please leave a message here and we will reply you within 12 hours.
                </div>
                <form
                  class="layui-form"
                  method="post"
                  id="contactPageForm"
                  action="javascript:;"
                >
                  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
                  <input
                    type="hidden"
                    name="subject"
                    value="New Inquiry from hssolar.com Contact Page"
                  />
                  <input type="hidden" name="from_name" value="Homesun Website" />

                  <ul class="clearfix">
                    <li>
                      <span class="ms_e">
                        <input
                          lay-verType="tips"
                          lay-verify="required|email"
                          lay-reqText="Please enter a valid email"
                          type="text"
                          name="email"
                          class="meInput"
                          placeholder="Your Email *"
                        />
                      </span>
                    </li>
                    <li>
                      <span class="ms_p">
                        <input
                          type="text"
                          name="phone"
                          class="meInput"
                          placeholder="Phone / WhatsApp"
                        />
                      </span>
                    </li>
                    <li>
                      <span class="ms_m">
                        <textarea
                          lay-verType="tips"
                          lay-verify="required"
                          lay-reqText="Please enter your inquiry details"
                          placeholder="Enter your inquiry details (such as your country, product model and quantity, etc.) and other specific requirements to get an accurate quote *"
                          maxlength="3000"
                          name="message"
                        ></textarea>
                      </span>
                    </li>
                    <div class="clearfix"></div>
                  </ul>
                  <button class="send_btn" lay-submit lay-filter="contact" type="button">
                    Submit
                  </button>
                </form>
              </div>
            </div>

            <!-- 右侧 Get in touch 服务卡片 -->
            <div class="col-sm-6">
              <div class="other page">
                <div class="section_title">Get in touch</div>
                <div class="det_pic_content clearfix" style="margin-top: 24px;">
                  <ul id="list_three" class="list">
                    <li>
                      <div class="column">
                        <a class="image" href="/category.html">
                          <img
                            src="/Public/theme/default/picture/contact-1.jpg"
                            alt="Customer Demand"
                          />
                        </a>
                        <div class="wrap">
                          <a class="title" href="/category.html">Customer Demand</a>
                          <div class="text">
                            Meet customer demands for PV products like solar cells, modules,
                            inverters, and energy storage systems.
                          </div>
                        </div>
                      </div>
                    </li>
                    <li>
                      <div class="column">
                        <a class="image" href="/technical-services.html">
                          <img
                            src="/Public/theme/default/picture/contact-2.jpg"
                            alt="Technical Support"
                          />
                        </a>
                        <div class="wrap">
                          <a class="title" href="/technical-services.html">Technical Support</a>
                          <div class="text">
                            Provide professional technical support and answer customers' questions
                            about PV products and system sizing.
                          </div>
                        </div>
                      </div>
                    </li>
                    <li>
                      <div class="column">
                        <a class="image" href="/faq.html">
                          <img
                            src="/Public/theme/default/picture/contact-3.jpg"
                            alt="After-sales Service"
                          />
                        </a>
                        <div class="wrap">
                          <a class="title" href="/faq.html">After-sales Service</a>
                          <div class="text">
                            Offer comprehensive after-sales services, including warranty support,
                            replacement, and system upgrade guidance.
                          </div>
                        </div>
                      </div>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 修复原站右侧卡片内联小字号并保持 B2B 视觉统一 */
  .contact .section_title {
    font-size: 24px !important;
    font-weight: 700 !important;
    color: #111827 !important;
  }
  .contact_info .wrap em {
    font-style: normal;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #111827 !important;
  }
  .contact_info .wrap p,
  .contact_info .wrap p a {
    font-size: 14.5px !important;
    color: #4b5563 !important;
  }
  #list_three .wrap .title {
    display: block;
    font-size: 16.5px !important;
    font-weight: 700 !important;
    color: #2596d1 !important;
    margin-bottom: 6px;
  }
  #list_three .wrap .text {
    font-size: 14px !important;
    line-height: 1.65 !important;
    color: #4b5563 !important;
    height: auto !important;
  }
</style>