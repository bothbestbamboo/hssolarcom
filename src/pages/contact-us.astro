---
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import { SITE } from '../data/site';

const CONTACT_BANNER = '/Public/theme/default/image/contact-us.jpg';
---

<BaseLayout
  title="Contact - Homesun: China Solar Panels Supplier"
  description="Buy solar panels directly from China supplier. Homesun manufactures solar panels, modules, inverters and offers full solar solutions, factory based in China with worldwide shipping."
  keywords="solar panels, china, supplier"
  preloadImage={CONTACT_BANNER}
>
  <InnerBanner
    title="Get in Touch"
    subtitle="Request factory-direct pricing, technical datasheets, or custom solar system design from our engineering team."
    bannerImg={CONTACT_BANNER}
    bannerAlt="Contact Homesun Solar"
    breadcrumbs={[{ label: 'Get in Touch' }]}
  />

  <section class="hs-inner-section">
    <div class="hs-inner-container">
      <!-- 1. 顶部三列现代联系方式卡 -->
      <div class="hs-con-cards">
        <a rel="nofollow" href={`Tel:${SITE.phone}`} class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <div class="hs-con-label">Phone / WhatsApp</div>
            <div class="hs-con-value">{SITE.phone}</div>
            <div class="hs-con-note">Direct factory export desk</div>
          </div>
        </a>

        <a rel="nofollow" href={`mailto:${SITE.email}`} class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div>
            <div class="hs-con-label">Sales Email</div>
            <div class="hs-con-value">{SITE.email}</div>
            <div class="hs-con-note">Fast reply within 12 hours</div>
          </div>
        </a>

        <div class="hs-con-card">
          <div class="hs-con-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="hs-con-label">Factory Address</div>
            <div class="hs-con-value">{SITE.address}</div>
            <div class="hs-con-note">Global container &amp; project shipping</div>
          </div>
        </div>
      </div>

      <!-- 2. 主体双栏：左询盘表单 + 右服务保障与微信二维码 -->
      <div class="hs-con-main">
        <div class="hs-surface-card hs-con-form-card">
          <span class="hs-con-eyebrow">SEND A MESSAGE</span>
          <h2>Request a Quotation</h2>
          <p class="hs-con-desc">
            Share your project country, required wattage or product model, and estimated order volume. Our team will send a tailored quotation and datasheet within 12 hours.
          </p>

          <form class="layui-form hs-con-form" method="post" id="contactPageForm">
            <input type="hidden" name="access_key" value={SITE.web3formsKey} />
            <input type="hidden" name="subject" value="New Inquiry from hssolar.com Contact Page" />
            <input type="hidden" name="from_name" value="Homesun Website" />

            <div class="hs-con-field">
              <label for="con-email">Business Email *</label>
              <input
                id="con-email"
                lay-verify="required|email"
                lay-reqText="Please enter a valid email"
                type="email"
                name="email"
                placeholder="name@company.com"
              />
            </div>

            <div class="hs-con-field">
              <label for="con-phone">Phone / WhatsApp</label>
              <input
                id="con-phone"
                type="text"
                name="phone"
                placeholder="Include country code for faster communication"
              />
            </div>

            <div class="hs-con-field">
              <label for="con-msg">Inquiry Details *</label>
              <textarea
                id="con-msg"
                lay-verify="required"
                lay-reqText="Please enter your inquiry details"
                rows="6"
                maxlength="3000"
                name="message"
                placeholder="Tell us your country, product model (e.g., 730W HJT, 550W PERC, Hybrid BESS), and quantity..."
              ></textarea>
            </div>

            <button class="hs-con-submit" lay-submit lay-filter="contact" type="submit">
              Submit Inquiry
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </form>
        </div>

        <div class="hs-con-right">
          <div class="hs-surface-card hs-con-wechat">
            <img
              src={SITE.wechatQr}
              alt="Homesun Solar WeChat QR"
              width="112"
              height="112"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>Connect via WeChat</h3>
              <p>Scan the QR code to speak directly with our export sales specialist for urgent orders and factory tour scheduling.</p>
            </div>
          </div>

          <div class="hs-con-services">
            <a href="/category.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-1.jpg" alt="Customer Demand" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>Customer Demand</h3>
                <p>Full-range supply of PV cells, modules, inverters, battery storage, and mounting structures.</p>
              </div>
            </a>

            <a href="/technical-services.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-2.jpg" alt="Technical Support" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>Technical Support</h3>
                <p>Dedicated engineering assistance on system sizing, inverter matching, and installation guides.</p>
              </div>
            </a>

            <a href="/faq.html" class="hs-con-srv-card">
              <div class="hs-con-srv-img">
                <img src="/Public/theme/default/picture/contact-3.jpg" alt="After-sales Service" loading="lazy" decoding="async" />
              </div>
              <div class="hs-con-srv-body">
                <h3>After-sales Service</h3>
                <p>Comprehensive warranty support, remote troubleshooting, and long-term upgrade guidance.</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hs-con-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .hs-con-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  a.hs-con-card:hover {
    transform: translateY(-3px);
    border-color: #93c5fd;
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .hs-con-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #eff6ff;
    color: #2596d1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hs-con-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #2596d1;
    margin-bottom: 4px;
  }

  .hs-con-value {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.4;
    word-break: break-word;
  }

  .hs-con-note {
    font-size: 13px;
    color: #64748b;
    margin-top: 3px;
  }

  .hs-con-main {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: 28px;
    align-items: start;
  }

  .hs-con-eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #2596d1;
    margin-bottom: 6px;
  }

  .hs-con-form-card h2 {
    margin: 0 0 10px;
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
  }

  .hs-con-desc {
    margin: 0 0 24px;
    font-size: 14.5px;
    line-height: 1.68;
    color: #64748b;
  }

  .hs-con-field {
    margin-bottom: 16px;
  }

  .hs-con-field label {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 6px;
  }

  .hs-con-field input,
  .hs-con-field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    background: #f8fafc;
    color: #0f172a;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-field input:focus,
  .hs-con-field textarea:focus {
    background: #ffffff;
    border-color: #2596d1;
    box-shadow: 0 0 0 3px rgba(37, 150, 209, 0.14);
  }

  .hs-con-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 28px;
    border-radius: 999px;
    border: none;
    background: linear-gradient(135deg, #2596d1 0%, #1a7bb9 100%);
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(37, 150, 209, 0.26);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(37, 150, 209, 0.36);
  }

  .hs-con-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hs-con-wechat {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
  }

  .hs-con-wechat img {
    width: 104px;
    height: 104px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    flex-shrink: 0;
  }

  .hs-con-wechat h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
  }

  .hs-con-wechat p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: #64748b;
  }

  .hs-con-services {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hs-con-srv-card {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .hs-con-srv-card:hover {
    transform: translateY(-2px);
    border-color: #93c5fd;
    box-shadow: 0 12px 26px rgba(15, 23, 42, 0.06);
  }

  .hs-con-srv-img {
    height: 100%;
    min-height: 112px;
    overflow: hidden;
    background: #f1f5f9;
  }

  .hs-con-srv-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hs-con-srv-body {
    padding: 16px 18px;
  }

  .hs-con-srv-body h3 {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    transition: color 0.18s ease;
  }

  .hs-con-srv-card:hover .hs-con-srv-body h3 {
    color: #2596d1;
  }

  .hs-con-srv-body p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.58;
    color: #64748b;
  }

  @media (max-width: 991px) {
    .hs-con-cards,
    .hs-con-main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hs-con-wechat {
      flex-direction: column;
      text-align: center;
    }
    .hs-con-srv-card {
      grid-template-columns: 1fr;
    }
    .hs-con-srv-img {
      aspect-ratio: 16 / 9;
    }
  }
</style>