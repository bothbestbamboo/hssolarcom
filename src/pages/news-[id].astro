---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import InnerBanner from '../components/InnerBanner.astro';
import NewsSidebar from '../components/NewsSidebar.astro';

export async function getStaticPaths() {
  const allEntries = await getCollection('news');
  const sorted = [...allEntries].sort((a, b) => a.data.id - b.data.id);

  return sorted.map((entry) => {
    const sameType = sorted.filter((item) => item.data.type === entry.data.type);
    const idx = sameType.findIndex((item) => item.data.id === entry.data.id);
    return {
      params: { id: String(entry.data.id) },
      props: {
        entry,
        prev: idx > 0 ? sameType[idx - 1] : null,
        next: idx < sameType.length - 1 ? sameType[idx + 1] : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

const parentMap: Record<string, { label: string; href: string; banner: string }> = {
  news: { label: 'News', href: '/news.html', banner: '/Public/theme/default/image/news.jpg' },
  case: { label: 'Project', href: '/project.html', banner: '/Public/theme/default/image/project.jpg' },
  project: { label: 'Project', href: '/project.html', banner: '/Public/theme/default/image/project.jpg' },
  solution: { label: 'Solution', href: '/category-5.html', banner: '/Public/theme/default/image/news.jpg' },
  knowledge: { label: 'Play Solar', href: '/play-solar.html', banner: '/Public/theme/default/image/play-solar.jpg' },
};

const parentCrumb = parentMap[entry.data.type] || parentMap.news;
const sidebarType = entry.data.type === 'project' ? 'case' : entry.data.type;
---

<BaseLayout
  title={entry.data.seoTitle || `${entry.data.title} - Homesun Solar`}
  description={entry.data.description || entry.data.summary}
  keywords={entry.data.keywords}
>
  <InnerBanner
    title={parentCrumb.label}
    bannerImg={parentCrumb.banner}
    breadcrumbs={[parentCrumb, { label: entry.data.title }]}
  />

  <div class="n_main">
    <div class="container clearfix">
      <!-- 右侧正文区 -->
      <div id="sidebar" class="penci-sticky-sidebar n_right">
        <div class="theiaStickySidebar">
          <div class="blog_main">
            <h1>{entry.data.title}</h1>
            {entry.data.date && (
              <div class="blog-info">
                <i class="fa fa-calendar"></i>{entry.data.date}
              </div>
            )}
            <div class="blog_p page phone markdown-body">
              <Content />
            </div>

            <ul class="navigation clearfix">
              {prev && (
                <li class="prev_post">
                  <a href={`/news-${prev.data.id}.html`}>
                    <span class="meta_nav">Previous</span>
                    <div class="post_title">{prev.data.title}</div>
                  </a>
                </li>
              )}
              {next && (
                <li class="next_post">
                  <a href={`/news-${next.data.id}.html`}>
                    <span class="meta_nav">Next</span>
                    <div class="post_title">{next.data.title}</div>
                  </a>
                </li>
              )}
            </ul>
          </div>
        </div>
      </div>

      <!-- 左侧栏 -->
      <NewsSidebar activeType={sidebarType} />
    </div>
  </div>
</BaseLayout>