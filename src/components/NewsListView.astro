---
import type { CollectionEntry } from 'astro:content';
import NewsSidebar from './NewsSidebar.astro';

interface Props {
  items: CollectionEntry<'news'>[];
  activeType?: 'news' | 'case' | 'solution' | 'knowledge';
  buttonText?: string;
  emptyText?: string;
  pageSize?: number;
}

const {
  items,
  activeType = 'news',
  buttonText = 'Read Article',
  emptyText = 'No articles published in this section yet.',
  pageSize = 10,
} = Astro.props;

const badgeLabel =
  activeType === 'case'
    ? 'Case Study'
    : activeType === 'solution'
      ? 'Solution'
      : activeType === 'knowledge'
        ? 'Solar Guide'
        : 'Industry News';

const formatDate = (dateStr?: string) => (dateStr ? dateStr.slice(0, 10) : '');
---

<section class="hs-inner-section">
  <div class="hs-inner-container hs-two-col">
    <!-- 左侧栏 -->
    <NewsSidebar activeType={activeType} />

    <!-- 右侧主列表 -->
    <div class="hs-main-col">
      {items.length > 0 ? (
        <>
          <ul class="hs-article-list" id="news-list-container" data-page-size={pageSize}>
            {items.map((item, index) => (
              <li style={index >= pageSize ? 'display:none;' : ''}>
                <article class="hs-article-card">
                  <a href={`/news-${item.data.id}.html`} class="hs-article-media">
                    <picture>
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        loading={index < 3 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </picture>
                  </a>

                  <div class="hs-article-body">
                    <div class="hs-article-meta">
                      <span class="hs-article-badge">{badgeLabel}</span>
                      {item.data.date && <span>{formatDate(item.data.date)}</span>}
                    </div>
                    <a href={`/news-${item.data.id}.html`} class="hs-article-title">
                      {item.data.title}
                    </a>
                    {item.data.summary && (
                      <p class="hs-article-summary">{item.data.summary}</p>
                    )}
                    <a href={`/news-${item.data.id}.html`} class="hs-article-cta">
                      {buttonText}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </article>
              </li>
            ))}
          </ul>

          <div class="hs-pagination" id="news-pagination">
            <div class="hs-pag-links"></div>
            <div class="hs-pag-total">Total records: <strong>{items.length}</strong></div>
          </div>
        </>
      ) : (
        <div class="hs-empty-box">{emptyText}</div>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const list = document.getElementById('news-list-container');
    const pagBox = document.getElementById('news-pagination');
    if (!list || !pagBox) return;

    const pageSize = parseInt(list.dataset.pageSize || '10', 10);
    const items = Array.from(list.children);
    const total = items.length;
    const totalPages = Math.ceil(total / pageSize);

    if (totalPages <= 1) {
      pagBox.style.display = 'none';
      return;
    }

    const params = new URLSearchParams(window.location.search);
    let currentPage = Math.max(1, Math.min(totalPages, parseInt(params.get('page') || '1', 10) || 1));

    function render(page, shouldScroll) {
      currentPage = page;
      const start = (page - 1) * pageSize;
      const end = start + pageSize;

      items.forEach((li, idx) => {
        li.style.display = idx >= start && idx < end ? '' : 'none';
      });

      let linksHtml = '';
      if (currentPage > 1) {
        linksHtml += `<a href="javascript:void(0);" class="hs-pag-btn" data-page="${currentPage - 1}">Prev</a>`;
      }
      for (let i = 1; i <= totalPages; i++) {
        if (i === currentPage) {
          linksHtml += `<span class="hs-pag-current">${i}</span>`;
        } else {
          linksHtml += `<a href="javascript:void(0);" class="hs-pag-btn" data-page="${i}">${i}</a>`;
        }
      }
      if (currentPage < totalPages) {
        linksHtml += `<a href="javascript:void(0);" class="hs-pag-btn" data-page="${currentPage + 1}">Next</a>`;
      }

      pagBox.innerHTML =
        `<div class="hs-pag-links">${linksHtml}</div>` +
        `<div class="hs-pag-total">Showing <strong>${start + 1}–${Math.min(end, total)}</strong> of <strong>${total}</strong></div>`;

      if (shouldScroll) {
        const sectionEl = document.querySelector('.hs-inner-section');
        if (sectionEl) {
          sectionEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }
    }

    pagBox.addEventListener('click', function (e) {
      const target = e.target.closest('a[data-page]');
      if (!target) return;
      const nextPage = parseInt(target.dataset.page, 10);
      if (nextPage && nextPage !== currentPage) {
        render(nextPage, true);
      }
    });

    render(currentPage, false);
  })();
</script>