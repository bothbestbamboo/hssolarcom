---
import { getCollection } from 'astro:content';
import { getTopCategories, getSubCategories } from '../data/categories';

interface Props {
  activeCategoryId?: number;
}

const { activeCategoryId } = Astro.props;
const topCategories = getTopCategories();

const newProducts = (await getCollection('products'))
  .sort((a, b) => b.data.id - a.data.id)
  .slice(0, 5);
---

<aside class="hs-sidebar" aria-label="Product Navigation">
  <!-- 产品分类卡片 -->
  <section class="hs-side-card">
    <div class="hs-side-head">
      <span>Product Categories</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    </div>
    <div class="hs-side-body">
      <ul class="hs-cat-menu">
        <li class={`hs-cat-item ${!activeCategoryId ? 'is-active' : ''}`}>
          <div class="hs-cat-row">
            <a href="/category.html" class="hs-cat-link">All Products</a>
          </div>
        </li>
        {topCategories.map((top) => {
          const subs = getSubCategories(top.id);
          const isSubActive = subs.some((s) => s.id === activeCategoryId);
          const isTopActive = activeCategoryId === top.id || isSubActive;
          return (
            <li class={`hs-cat-item ${isTopActive ? 'is-active is-open' : ''}`}>
              <div class="hs-cat-row">
                <a href={`/category-${top.id}.html`} class="hs-cat-link">
                  {top.name}
                </a>
                {subs.length > 0 && (
                  <button
                    type="button"
                    class="hs-cat-toggle"
                    aria-label={`Toggle ${top.name} subcategories`}
                    aria-expanded={isTopActive ? 'true' : 'false'}
                  >
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                )}
              </div>
              {subs.length > 0 && (
                <ul class="hs-sub-menu">
                  {subs.map((sub) => (
                    <li class={activeCategoryId === sub.id ? 'is-active' : ''}>
                      <a href={`/category-${sub.id}.html`}>{sub.name}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- 最新产品推荐 -->
  <section class="hs-side-card">
    <div class="hs-side-head hs-side-head-light">
      <span>New Products</span>
    </div>
    <div class="hs-side-body">
      <ul class="hs-mini-products">
        {newProducts.map((item) => (
          <li>
            <a href={`/product-detail-${item.data.id}.html`} class="hs-mini-pro">
              <span class="hs-mini-pro-img">
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="hs-mini-pro-info">
                <span class="hs-mini-pro-title">{item.data.title}</span>
                <span class="hs-mini-pro-cta">View Specs →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 快捷工厂报价卡 -->
  <section class="hs-side-cta">
    <h4>Need a Custom BOM?</h4>
    <p>Share your project wattage and delivery port to get direct factory pricing within 12 hours.</p>
    <a href="/contact-us.html">Request Factory Quote</a>
  </section>
</aside>

<script is:inline>
  (function () {
    document.querySelectorAll('.hs-cat-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var li = btn.closest('.hs-cat-item');
        if (!li) return;
        var isOpen = li.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  })();
</script>