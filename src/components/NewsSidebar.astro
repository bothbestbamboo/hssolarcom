---
import { getCollection } from 'astro:content';

interface Props {
  activeType?: 'news' | 'case' | 'solution' | 'knowledge';
}

const { activeType = 'news' } = Astro.props;

const latestNews = (await getCollection('news'))
  .filter((n) => n.data.type === 'news')
  .sort((a, b) => {
    const timeDiff = new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
    return timeDiff !== 0 ? timeDiff : b.data.id - a.data.id;
  })
  .slice(0, 8);
---

<div id="main" class="n_left penci-main-sticky-sidebar">
  <div class="theiaStickySidebar">
    <div class="modules">
      <!-- 蓝色 Category 栏目框 -->
      <section class="block left_nav">
        <div class="unfold nav_h4">Category</div>
        <div class="toggle_content clearfix">
          <ul class="mtree">
            <li class={`clearfix ${activeType === 'news' ? 'active' : ''}`}>
              <span></span>
              <a href="/news.html">News<i></i></a>
            </li>
            <li class={`clearfix ${activeType === 'case' ? 'active' : ''}`}>
              <span></span>
              <a href="/project.html">Project<i></i></a>
            </li>
          </ul>
        </div>
        <script is:inline src="/Public/theme/default/js/mtree.js"></script>
      </section>

      <!-- Recently Updated（自动取最新 8 篇新闻） -->
      <section class="block blog_nav blog_nav2">
        <div class="unfold left_h4">Recently Updated</div>
        <div class="toggle_content clearfix">
          <ul>
            {latestNews.map((item) => (
              <li>
                <a href={`/news-${item.data.id}.html`}>
                  <i class="fa fa-caret-right"></i>{item.data.title}
                </a>
                <i></i>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Tags -->
      <section class="block hot_tags">
        <div class="unfold left_h4">Tags</div>
        <div class="toggle_content clearfix">
          <a href="/category-tags-5.html">Monofacial</a>
          <a href="/category-tags-6.html">Bifacial</a>
          <a href="/category-tags-7.html">730W</a>
        </div>
      </section>
    </div>
  </div>
</div>